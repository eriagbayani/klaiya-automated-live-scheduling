      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Guard against Groq failure or low-confidence output.\nconst r = $input.first().json;\nconst original = $('Absence Message (Telegram)').first().json;\n\nlet parsed = null;\ntry {\n  parsed = JSON.parse(r.choices[0].message.content);\n} catch (e) {\n  parsed = null;\n}\n\nconst valid = parsed\n  && typeof parsed.date === 'string'\n  && /^\\d{4}-\\d{2}-\\d{2}$/.test(parsed.date)\n  && Number(parsed.confidence) >= 0.7;\n\nreturn [{ json: {\n  needsHumanReview: !valid,\n  staffName: parsed ? parsed.staffName : null,\n  date: parsed ? parsed.date : null,\n  startTime: (parsed && parsed.startTime) || '00:00',\n  endTime: (parsed && parsed.endTime) || '23:59',\n  reason: (parsed && parsed.reason) || 'Not stated',\n  isFullDay: parsed ? Boolean(parsed.isFullDay) : true,\n  confidence: parsed ? Number(parsed.confidence) : 0,\n  rawMessage: original.message.text,\n  chatId: original.message.chat.id,\n  parseSource: parsed ? 'groq' : 'failed',\n}}];"
      },
