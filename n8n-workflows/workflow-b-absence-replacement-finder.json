    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Single-slot version of the Workflow A engine.\n// Same hard constraints, same fairness ranking - so absences do not quietly\n// undo fair allocation the way a first-responder group chat does.\nconst one = (v) => Array.isArray(v) ? v[0] : v;\n// The Airtable node returns either { id, fields:{...} } or a flattened\n// { id, ...fieldValues } depending on node version. Normalise both shapes.\nconst REC = (j) => (j && j.fields) ? j : { id: j && j.id, fields: j || {} };\nconst rows = (n) => { try { return $(n).all().map(i => REC(i.json)).filter(r => r && r.id); } catch (e) { return []; } };\n\nconst p        = $('Validate Parse').first().json;\n// All seeded staff share one Telegram Chat ID during testing, so the sender\n// lookup can return several rows. Prefer the one whose name Groq extracted;\n// in production each staff member has a unique chat id and this picks the only match.\nconst senders  = rows('Find Staff');\nconst absentEl = senders.find(x => (x.fields['Name'] || '') === p.staffName) || senders[0] || REC($('Find Staff').first().json);\nconst slot     = REC($('Find Affected Assignments').first().json);\n\nconst need = {\n  date:      one(slot.fields['Session Date']),\n  startTime: one(slot.fields['Session Start']),\n  endTime:   one(slot.fields['Session End']),\n  client:    one(slot.fields['Session Client']),\n  role:      slot.fields['Role'],\n  sessionId: one(slot.fields['Session']),\n};\n\nconst toMin = (t) => { const [h, m] = String(t || '0:0').split(':').map(Number); return h * 60 + m; };\nconst overlaps = (aS, aE, bS, bE, buf = 0) => toMin(aS) < toMin(bE) + buf && toMin(bS) < toMin(aE) + buf;\nconst contains = (oS, oE, iS, iE) => toMin(oS) <= toMin(iS) && toMin(oE) >= toMin(iE);\n\nconst staff = rows('Get Candidate Staff').map(r => ({\n  id: r.id, name: r.fields['Name'], role: r.fields['Role'],\n  active: Boolean(r.fields['Active']),\n  certifiedClients: r.fields['Certified Clients'] || [],\n  notifyChannel: r.fields['Notify Channel'] || 'Email',\n}));\nconst avail = rows('Get Availability (Date)').map(r => ({\n  staffId: one(r.fields['Staff']),\n  from: r.fields['Available From'], to: r.fields['Available To'],\n}));\nconst booked = rows('Get Assignments (Date)').map(r => ({\n  staffId: one(r.fields['Staff']),\n  start: one(r.fields['Session Start']), end: one(r.fields['Session End']),\n  weight: r.fields['Weight'] || 1,\n}));\n\nconst loadByStaff = {};\nfor (const b of booked) loadByStaff[b.staffId] = (loadByStaff[b.staffId] || 0) + Number(b.weight);\n\nconst check = (person) => {\n  if (person.id === absentEl.id) return 'is-the-absent-person';\n  if (!person.active) return 'inactive';\n  if (person.role !== need.role && person.role !== 'Both') return 'wrong-role';\n  const covered = avail.filter(a => a.staffId === person.id)\n    .some(a => contains(a.from, a.to, need.startTime, need.endTime));\n  if (!covered) return 'not-available';\n  const clash = booked.filter(b => b.staffId === person.id)\n    .some(b => overlaps(b.start, b.end, need.startTime, need.endTime, 30));\n  if (clash) return 'already-booked';\n  return null;\n};\n\nconst eligible = staff.filter(p2 => check(p2) === null);\n\n// nearest misses: failed exactly one soft-ish constraint - gives the scheduler\n// something actionable instead of \"no match found\"\nconst nearestMisses = staff\n  .map(p2 => ({ name: p2.name, blockedBy: check(p2) }))\n  .filter(x => ['not-available', 'already-booked', 'wrong-role'].includes(x.blockedBy))\n  .slice(0, 5);\n\neligible.sort((a, b) => (loadByStaff[a.id] || 0) - (loadByStaff[b.id] || 0));\nconst replacement = eligible[0] || null;\n\nreturn [{ json: {\n  replacement,\n  found: Boolean(replacement),\n  nearestMisses,\n  need,\n  originalAssignmentId: slot.id,\n  absentStaffName: absentEl.fields['Name'],\n  absentStaffId: absentEl.id,\n  reason: p.reason,\n}}];"
      },
