        "jsonBody": "={{ JSON.stringify({ model: \"llama-3.3-70b-versatile\", temperature: 0.3, messages: [ { role: \"system\", content: \"You alert a scheduling manager that a staff absence has no automatic replacement. State: who is out, which session is now uncovered, and the nearest-miss candidates with the one constraint each failed. Be direct - this is time-sensitive. Max 120 words. Plain text.\" }, { role: \"user\", content: \"Absent: \" + $json.absentStaffName + \"\\nSession: \" + $json.need.client + \" \" + $json.need.date + \" \" + $json.need.startTime + \"-\" + $json.need.endTime + \"\\nRole needed: \" + $json.need.role + \"\\nNearest misses: \" + JSON.stringify($json.nearestMisses) } ] }) }}",
